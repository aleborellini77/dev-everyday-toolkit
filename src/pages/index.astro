---
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell.astro';
import TerminalBar from '../components/TerminalBar.astro';
import CategorySection from '../components/CategorySection.astro';
import { loadSite } from '../lib/site-data';
import { url } from '../lib/url';

// loadSite() fa fallire la build, con file e riga, se un file è scritto male.
const { categories, tags, paths } = await loadSite();
const editBase = import.meta.env.PUBLIC_EDIT_URL ?? '';
const total = categories.reduce((n, c) => n + c.tools.length, 0);
---
<Base>
  <AppShell>
    <TerminalBar />
    <div class="frame">
      <aside class="sidebar">
        <div class="brand">
          <span class="index"><span class="user">dev</span><span class="path">@macbook-pro-m1 ~ %</span></span>
          <h1>Dev / IT Toolkit<span class="cursor"></span></h1>
          <p>jump to the category matching the symptom, then the tool that isolates the cause</p>
        </div>
        {paths.length > 0 && (
          <a class="side-link" href={url('percorsi/')}>
            <span>diagnosis paths</span><span class="nav-count">{paths.length} →</span>
          </a>
        )}
        <div class="search-box">
          <input id="search" type="text" placeholder="grep tools..." autocomplete="off" aria-label="Filter tools" />
        </div>
        {tags.length > 0 && (
          <div class="tag-bar" role="group" aria-label="Filter by tag">
            {tags.map((t) => (
              <button type="button" class="tag-chip" data-tag={t.id} title={t.description} aria-pressed="false">
                #{t.id}<span class="tag-count">{t.count}</span>
              </button>
            ))}
            <button type="button" class="tag-reset" id="tag-reset" hidden>reset</button>
          </div>
        )}
        <ul class="nav-list">
          {categories.map((c, i) => (
            <li>
              <a href={`#${c.id}`} data-nav={c.id}>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span>{c.title}</span>
                <span class="nav-count">{c.tools.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
      <main>
        <div class="lead">
          <h2># {categories.length} categories, {total} tools, organized by the shape of the problem someone hands you.</h2>
        </div>
        {categories.map((c, i) => (
          <CategorySection id={c.id} title={c.title} when={c.when} index={i} tools={c.tools} editUrl={editBase ? `${editBase}${c.id}.md` : ''} />
        ))}
        <p class="no-results" id="no-results">$ grep: no matches found</p>
        <footer>
          Built as a personal reference — verify a tool still fits before relying on it under pressure. Links open in a new tab.
        </footer>
      </main>
    </div>
  </AppShell>

  <script>
    // --- search + tag filter (i due filtri si combinano: i tag sono in AND) ---
    const input = document.getElementById('search') as HTMLInputElement;
    const sections = [...document.querySelectorAll<HTMLElement>('section.category')];
    const empty = document.getElementById('no-results')!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.tag-chip')];
    const reset = document.getElementById('tag-reset') as HTMLButtonElement | null;
    const active = new Set<string>();

    function apply() {
      const q = input.value.trim().toLowerCase();
      let any = false;
      for (const s of sections) {
        const titleHit = !q || (s.dataset.title ?? '').includes(q);
        let hit = false;
        s.querySelectorAll<HTMLElement>('.tool-card').forEach((card) => {
          const cardTags = (card.dataset.tags ?? '').split(' ');
          const tagOk = [...active].every((t) => cardTags.includes(t));
          const textOk = titleHit || (card.dataset.search ?? '').includes(q);
          const match = tagOk && textOk;
          card.classList.toggle('is-hidden', !match);
          if (match) hit = true;
        });
        s.classList.toggle('is-hidden', !hit);
        any ||= hit;
      }
      empty.classList.toggle('show', !any);
      chips.forEach((c) => {
        const on = active.has(c.dataset.tag!);
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      if (reset) reset.hidden = active.size === 0;
      // Lo stato dei tag resta nell'indirizzo (?tag=cli,brew): il filtro si può condividere.
      try {
        const u = new URL(location.href);
        if (active.size) u.searchParams.set('tag', [...active].join(','));
        else u.searchParams.delete('tag');
        history.replaceState(null, '', u);
      } catch {}
    }

    input.addEventListener('input', apply);
    chips.forEach((c) => c.addEventListener('click', () => {
      const t = c.dataset.tag!;
      if (active.has(t)) active.delete(t); else active.add(t);
      apply();
    }));
    reset?.addEventListener('click', () => { active.clear(); apply(); });

    const known = new Set(chips.map((c) => c.dataset.tag!));
    (new URLSearchParams(location.search).get('tag') ?? '').split(',').filter((t) => known.has(t)).forEach((t) => active.add(t));
    if (active.size) apply();

    // --- scroll-spy ---
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.toggle('active', a.dataset.nav === e.target.id));
      }
    }, { rootMargin: '-10% 0px -75% 0px' });
    sections.forEach((s) => spy.observe(s));
    links[0]?.classList.add('active');
  </script>
</Base>
