---
import { inline } from '../lib/inline';
interface Props { name: string; url: string; description: string; cmd?: string; tags?: string[]; note?: string; from?: string }
const { name, url, description, cmd, tags = [], note, from } = Astro.props;
const host = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const search = `${name} ${description} ${host} ${cmd ?? ''} ${tags.join(' ')}`.toLowerCase();
---
<a class="tool-card" href={url} target="_blank" rel="noopener" data-search={search} data-tags={tags.join(' ')}>
  <div class="row1">
    <span class="name">{name}</span>
    <span class="url mono">{cmd ?? host}</span>
  </div>
  <div class="desc">{description}</div>
  {note && <div class="note" set:html={inline(note, false)} />}
  {(tags.length > 0 || from) && (
    <div class="card-tags">
      {from && <span class="from">{from}/</span>}
      {tags.map((t) => <span class="tag">#{t}</span>)}
    </div>
  )}
</a>
