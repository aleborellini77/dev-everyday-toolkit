<div class="gate" id="gate" hidden>
  <div class="gate-box">
    <p class="gline">toolkit login — <span class="amber">restricted</span></p>
    <p class="gline">authentication required to continue</p>
    <form id="gate-form">
      <div class="gate-row">
        <span>$</span>
        <input id="gate-pw" type="password" placeholder="password" autocomplete="off" />
      </div>
    </form>
    <p class="gate-error" id="gate-error" aria-live="polite"></p>
  </div>
</div>
